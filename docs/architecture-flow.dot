digraph G {
  rankdir=LR;
  node [shape=box, style="rounded", fontname="Arial"];

  api [label="API Gateway HTTP API\nGET /price-lists/{priceListId}"];
  lambda [label="AWS Lambda Java 21\nFunctionInvoker"];
  router [label="apiGatewayRouter\nApiGatewayRouterFunction"];
  handler [label="GetPriceListRouteHandler\nrouteKey dispatch"];
  function [label="ListPriceFunction\nlocal/direct function"];
  usecase [label="GetPriceListUseCase"];
  service [label="GetPriceListService"];
  port [label="LoadProductsPort"];
  adapter [label="InMemoryProductAdapter\nDynamo later"];

  api -> lambda -> router -> handler -> function -> usecase -> service -> port -> adapter;
}
